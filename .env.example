# Deepgram — server only. Key must have Member scope or higher.
# https://console.deepgram.com/ -> API Keys
DEEPGRAM_API_KEY=

# NOTE: no OPENAI_API_KEY is needed. Deepgram provides a managed OpenAI
# LLM when agent.think has no `endpoint`, so no key ever reaches the browser.

# Supabase — server only. Project Settings -> API
# URL looks like https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase secret key. Settings -> API Keys -> "Secret keys" -> default (sb_secret_...).
# This is the new name for the service_role key. NOT the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy token — server/CLI only, never used at runtime.
# vercel.com -> Account Settings -> Tokens -> Create
VERCEL_TOKEN=
